<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>JipperKeyViewer</AssemblyName>
    <RootNamespace>JipperKeyViewer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- 内嵌默认字体（对齐原 Mod 内嵌 MAPLESTORY_OTF_BOLD.OTF） -->
    <EmbeddedResource Include="Assets\MAPLESTORY_OTF_BOLD.OTF" />
    <!-- 内嵌程序图标（exe 资源图标 + 运行时加载：托盘/设置窗口/显示窗口标题栏） -->
    <EmbeddedResource Include="Assets\app.ico" />
    <!-- 内嵌弹窗图标（重命名提示 info / 删除确认 warning / Default 编辑拒绝 error） -->
    <EmbeddedResource Include="Assets\warning.png" />
    <EmbeddedResource Include="Assets\info.png" />
    <EmbeddedResource Include="Assets\error.png" />
    <!-- 关于页横幅（WPF Resource：可用 pack URI 直接引用） -->
    <Resource Include="Assets\about-banner.png" />
    <!-- 关于页使用字体（来自 22about.docx 内嵌字体，用户已确认授权可用） -->
    <Resource Include="Assets\fonts\hurme-geometric-bold.ttf" />
    <Resource Include="Assets\fonts\shiliuzi-laihu2.ttf" />
    <Resource Include="Assets\fonts\noto-sans-sc.ttf" />
    <!-- .jkv 文件关联图标：内嵌进 exe，运行时自动释放到 JipperKeyViewer 目录（注册表 DefaultIcon 指向该目录） -->
    <EmbeddedResource Include="jkv.ico" />
  </ItemGroup>
</Project>

