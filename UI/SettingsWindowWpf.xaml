<Window x:Class="JipperKeyViewer.UI.SettingsWindowWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:JipperKeyViewer.UI"
        Title="配置项" Height="720" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="Microsoft YaHei" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ===== 关于页字体（来自 22about.docx 内嵌字体子集，随程序内嵌） ===== -->
    <FontFamily x:Key="FntAboutTitle">pack://application:,,,/Assets/fonts/#HurmeGeometricSans1W03-Bold</FontFamily>
    <FontFamily x:Key="FntAboutLaiHu">pack://application:,,,/Assets/fonts/#拾陆字濑户2.0-1</FontFamily>
    <FontFamily x:Key="FntAboutNoto">pack://application:,,,/Assets/fonts/#Noto Sans SC</FontFamily>

    <!-- ===== 色板（对齐 UI 稿；运行时由代码按系统主题切换暗/亮两套） ===== -->
        <SolidColorBrush x:Key="Bg" Color="#16181A"/>
        <SolidColorBrush x:Key="Panel" Color="#202225"/>
        <SolidColorBrush x:Key="Panel2" Color="#232529"/>
        <SolidColorBrush x:Key="Ctrl" Color="#2F3235"/>
        <SolidColorBrush x:Key="CtrlH" Color="#3A3D41"/>
        <SolidColorBrush x:Key="Line" Color="#3A3D41"/>
        <SolidColorBrush x:Key="Line2" Color="#45484D"/>
        <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Dim" Color="#FFFFFF"/>
    <!-- 别名/次要注释用灰（真正的灰色；Dim 在暗色主题下是纯白，不能当灰用） -->
    <SolidColorBrush x:Key="Alias" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="Acc" Color="#4A90D9"/>
        <SolidColorBrush x:Key="AccH" Color="#3D6EA5"/>
        <SolidColorBrush x:Key="Sel" Color="#36587F"/>
        <SolidColorBrush x:Key="Red" Color="#E06060"/>
        <SolidColorBrush x:Key="Green" Color="#6FBF73"/>
        <SolidColorBrush x:Key="BodyBg" Color="#1C1E21"/>

        <!-- ===== 段落标题（sec） ===== -->
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- ===== 提示框（hint） ===== -->
        <Style x:Key="Hint" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BodyBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <!-- ===== 行容器 ===== -->
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>

        <!-- ===== 通用按钮 ===== -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Ctrl}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlH}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{DynamicResource Red}"/>
        </Style>

        <!-- ===== 网格选择按钮（gcell，可选中） ===== -->
        <Style x:Key="Cell" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource Ctrl}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlH}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Sel}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 开关（toggle） ===== -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>   <!-- 相邻勾选项统一间距（横向行内用本地 Margin 覆盖） -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="{DynamicResource Ctrl}" BorderBrush="{DynamicResource Line2}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 3.5,9.5 L 7.5,13 L 14,5.5" Stroke="Transparent" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccH}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                                <Setter TargetName="Check" Property="Stroke" Value="White"/>
                            </Trigger>
                            <!-- 悬停：未勾选时提亮背景提示可点；已勾选时保持勾选高亮色，
                                 避免泛白导致误判为未勾选 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource CtrlH}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccH}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 折叠（details.fold） ===== -->
        <Style x:Key="Fold" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource Ctrl}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ToggleButton x:Name="Hd" Grid.Row="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                              HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Text}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="10,7">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 折叠指示箭头：等边三角形（Path 绘制，非字体字形）。12×12 渲染框内
                                             三顶点 (10.62,6)(3.69,2)(3.69,10)，边长 8、几何中心 (6,6)=渲染框正中；
                                             展开时绕中心旋转 90°，两种状态箭头均居中不偏移 -->
                                        <Path x:Name="Tri" Width="12" Height="12"
                                              Data="M 10.62,6 L 3.69,2 L 3.69,10 Z"
                                              Fill="{DynamicResource Dim}" Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                        <ContentPresenter ContentSource="Header"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Border x:Name="Body" Grid.Row="1" Background="{DynamicResource BodyBg}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="0,1,0,0" Padding="10" Visibility="Collapsed">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Hd" Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Tri" Property="LayoutTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger SourceName="Hd" Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CtrlH}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 滑块（完整自定义模板：深色轨道 + 主题联动） ===== -->
        <Style x:Key="Slider" TargetType="Slider">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- 轨道横条先声明（下层），Track（含圆钮）后声明（上层）：
                                 圆钮覆盖在横条之上（正常交互逻辑；修复原横条压住圆钮的层级错误） -->
                            <Border IsHitTestVisible="False" Height="4" CornerRadius="2"
                                    Background="{DynamicResource Line2}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" CornerRadius="7" Cursor="Hand"
                                                        Background="{DynamicResource Acc}" BorderBrush="{DynamicResource AccH}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 下拉（完整自定义模板：背景/文字/下拉面板全部主题联动，修复白底白字） ===== -->
        <Style x:Key="SelBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Ctrl}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccH}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- 官方打开机制：整面 ToggleButton（背景+点击开合）→ 点击必开下拉；
                         内容层 IsHitTestVisible=False 不挡命中 -->
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource Ctrl}" BorderBrush="{DynamicResource Line2}"
                                                BorderThickness="1" CornerRadius="4"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Line2}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border Background="Transparent" IsHitTestVisible="False" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ContentPresenter Margin="0,0,18,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <Path x:Name="Arrow" Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Dim}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide" StaysOpen="False" VerticalOffset="2">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource Ctrl}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 下拉按钮（字体样式选择器：ToggleButton + Popup，视觉对齐 SelBox） ===== -->
        <Style x:Key="SelBoxBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Ctrl}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter Margin="0,0,18,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <Path x:Name="Arrow" Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Dim}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Line2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 输入框（完整模板：背景/文字主题联动） ===== -->
        <Style x:Key="Txt" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Ctrl}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 页签（TabControl 自定义模板：页签行右侧挂“保存”按钮） ===== -->
        <Style x:Key="Tabs" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="10,14,10,20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <!-- 右侧按钮放进横向 StackPanel：StackPanel 在堆叠方向上以无限宽度量测子元素，
                                     因此任何语言（英/韩）文字都不会被挤窄、不再出现"Reset 显示成 ese"的裁切 -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,2,0,0">
                                    <Button x:Name="ResetBtn" Content="重置" MinWidth="78"
                                            Style="{DynamicResource Btn}" Foreground="{DynamicResource Red}" Padding="12,5"
                                            Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold" Click="ResetClick"/>
                                    <Button x:Name="SaveBtn" Content="保存" MinWidth="78"
                                            Style="{DynamicResource Btn}" Padding="14,5" Cursor="Hand"
                                            FontWeight="SemiBold" Click="SaveClick"/>
                                </StackPanel>
                                <!-- 自定义 EvenTabPanel 代替默认 TabPanel：TabPanel 会把"当前选中项所在行"
                             挪到最后一行，导致点击第一排页签时两排互换；EvenTabPanel 固定顺序、
                             放不下时均分为两排（英文 7 页签 => 3 + 4），行序永远稳定。 -->
                        <ui:EvenTabPanel IsItemsHost="True" Background="Transparent"/>
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 键按钮排（kbtn） ===== -->
        <Style x:Key="Kbtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>

        <!-- ===== 颜色块 ===== -->
        <Style x:Key="ColorBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== 页签（贴窗口顶；页签行右侧为“保存”按钮） ===== -->
        <TabControl x:Name="Tabs" Style="{DynamicResource Tabs}" Background="{DynamicResource Panel}"
                    BorderThickness="0" Padding="10,14,10,20">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="11,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                        CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Ctrl}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Panel2}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Line}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                        <Setter TargetName="bd" Property="BorderThickness" Value="1,1,1,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ================================================== 通用页 ================================================== -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="重置计数" Style="{DynamicResource BtnRed}" Click="ResetCountsClick" Margin="0,0,0,11"/>

                        <Expander Header="配置: Default" Style="{DynamicResource Fold}" x:Name="expConfig">
                            <StackPanel>
                                <TextBlock Text="选中后立即应用" FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,0,0,4"/>
                                <StackPanel x:Name="spProfiles"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="新建" Style="{DynamicResource Btn}" Click="ConfigNewClick"/>
                                    <Button Content="重命名" Style="{DynamicResource Btn}" Margin="8,0,0,0" Click="ConfigRenameClick"/>
                                    <Button Content="删除" Style="{DynamicResource BtnRed}" Margin="8,0,0,0" Click="ConfigDeleteClick"/>
                                </StackPanel>
                                <Button Content="导入原 Mod 配置…" Style="{DynamicResource Btn}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="ImportProfileClick"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="导入/导出 程序配置文件 (.jkv)" Style="{DynamicResource Fold}" x:Name="expShare">
                            <StackPanel>
                                <TextBlock x:Name="txSelectedProfile" FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导出所选配置" Style="{DynamicResource Btn}" HorizontalAlignment="Stretch" Click="ExportPackageClick"/>
                                    <Button Content="导入配置…" Style="{DynamicResource Btn}" Margin="8,0,0,0" Click="ImportPackageClick"/>
                                </StackPanel>
                                <Border Style="{DynamicResource Hint}">
                                    <TextBlock Text="包含当前方案配置与自定义字体，一键导出/导入" FontSize="11" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <StackPanel Style="{DynamicResource Row}">
                            <TextBlock Text="语言:" FontSize="13" Foreground="{DynamicResource Dim}" Width="80" VerticalAlignment="Center"/>
                            <ComboBox Style="{DynamicResource SelBox}" x:Name="cmbLanguage">
                                <ComboBoxItem Content="English"/><ComboBoxItem Content="中文"/><ComboBoxItem Content="한국어"/>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Content="大数字千分位显示 1,234" Style="{DynamicResource Toggle}" x:Name="chkThousand"/>

                        <TextBlock Style="{DynamicResource Sec}" Text="字体样式:"/>
                        <StackPanel Style="{DynamicResource Row}">
                            <TextBlock Text="字体" FontSize="13" Foreground="{DynamicResource Dim}" Width="80" VerticalAlignment="Center"/>
                            <ComboBox Style="{DynamicResource SelBox}" x:Name="cmbFont"/>
                            <Button Content="刷新" Style="{DynamicResource Btn}" Margin="8,0,0,0" Click="RefreshFontsClick"/>
                        </StackPanel>
                        <StackPanel Style="{DynamicResource Row}">
                            <TextBlock Text="字体样式" FontSize="13" Foreground="{DynamicResource Dim}" Width="80" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="btnFontStyle" Style="{DynamicResource SelBoxBtn}" IsChecked="False">
                                <TextBlock x:Name="txtFontStyleSummary" Text="默认" FontSize="13"/>
                            </ToggleButton>
                            <Popup x:Name="popFontStyle" PlacementTarget="{Binding ElementName=btnFontStyle}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide"
                                   IsOpen="{Binding IsChecked, ElementName=btnFontStyle, Mode=TwoWay}">
                                <Border Background="{DynamicResource Ctrl}" BorderBrush="{DynamicResource Line2}" BorderThickness="1"
                                        CornerRadius="4" MinWidth="{Binding ActualWidth, ElementName=btnFontStyle}" MaxHeight="280" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="spFontStyle" Margin="2,2,2,2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <Border Style="{DynamicResource Hint}">
                            <TextBlock Text="CustomFont : JipperKeyViewer/fonts" FontSize="11" Foreground="{DynamicResource Dim}"/>
                        </Border>

                        <StackPanel Style="{DynamicResource Row}">
                            <Button Content="打开配置文件夹" Style="{DynamicResource Btn}" Click="OpenConfigClick"/>
                            <Button Content="打开字体文件夹" Style="{DynamicResource Btn}" Margin="8,0,0,0" Click="OpenFontsClick"/>
                        </StackPanel>

                        <CheckBox Content="KPS/Total置于下方" Style="{DynamicResource Toggle}" x:Name="chkDown"/>
                        <CheckBox Content="启用全局覆盖层" Style="{DynamicResource Toggle}" x:Name="chkOverlay"/>
                        <Border BorderThickness="1" BorderBrush="{DynamicResource Alias}" CornerRadius="4"
                                Padding="9,7,9,7" Margin="0,6,0,8" Background="#14000000">
                            <TextBlock x:Name="tbOverlayTip" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Alias}" LineHeight="18"/>
                        </Border>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="安全边距" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldSafeArea" Minimum="0" Maximum="12" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock x:Name="valSafeArea" Text="2" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>

                        <StackPanel x:Name="spLayoutGroups"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== 布局页 ================================================== -->
            <TabItem Header="布局">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="spLayoutGroups2"/>

                        <CheckBox Content="标准键宽" Style="{DynamicResource Toggle}" x:Name="chkStdWidth"/>

                        <Expander Header="独立按键字号调整" Style="{DynamicResource Fold}" x:Name="expPks">
                            <StackPanel>
                                <CheckBox Content="启用" Style="{DynamicResource Toggle}" x:Name="chkPksEnable" Checked="PksEnableChanged" Unchecked="PksEnableChanged"/>
                                <StackPanel x:Name="pksBody" Margin="0,6,0,0">
                                    <TextBlock Style="{DynamicResource Sec}" Text="第 1 排按键:"/>
                                    <StackPanel x:Name="pksRow1" Orientation="Horizontal" Margin="0,0,0,6"/>
                                    <TextBlock Style="{DynamicResource Sec}" Text="第 2 排按键:"/>
                                    <StackPanel x:Name="pksRow2" Orientation="Horizontal" Margin="0,0,0,6"/>
                                    <TextBlock Style="{DynamicResource Sec}" Text="第 3 排按键:"/>
                                    <StackPanel x:Name="pksRow3" Orientation="Horizontal" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="KPS" x:Name="btnPksKps" Style="{DynamicResource Kbtn}" Click="PksSlotClick"/>
                                        <Button Content="Total" x:Name="btnPksTotal" Style="{DynamicResource Kbtn}" Margin="5,0,0,0" Click="PksSlotClick"/>
                                    </StackPanel>
                                    <Button Content="重置按键大小" Style="{DynamicResource BtnRed}" Click="PksResetClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== 显示页 ================================================== -->
            <TabItem Header="显示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Sec}" Text="字体样式:"/>
                        <StackPanel Style="{DynamicResource Row}">
                            <TextBlock Text="字体" FontSize="13" Foreground="{DynamicResource Dim}" Width="80" VerticalAlignment="Center"/>
                            <ComboBox Style="{DynamicResource SelBox}" x:Name="cmbFont2"/>
                            <Button Content="刷新" Style="{DynamicResource Btn}" Margin="8,0,0,0" Click="RefreshFontsClick"/>
                        </StackPanel>
                        <Border Style="{DynamicResource Hint}">
                            <TextBlock Text="CustomFont : JipperKeyViewer/fonts" FontSize="11" Foreground="{DynamicResource Dim}"/>
                        </Border>

                        <CheckBox Content="隐藏按键独立计数" Style="{DynamicResource Toggle}" x:Name="chkHideMainCount"/>
                        <CheckBox Content="每键 KPS" Style="{DynamicResource Toggle}" x:Name="chkPerKeyKps"/>
                        <CheckBox Content="隐藏KPS/Total显示" Style="{DynamicResource Toggle}" x:Name="chkStreamer"/>
                        <CheckBox Content="隐藏KPS/Total标签文本" Style="{DynamicResource Toggle}" x:Name="chkHideLabel"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="按键文字大小" FontSize="13" Width="90" VerticalAlignment="Center"/>
                            <Slider Style="{DynamicResource Slider}" x:Name="sldKeyFont" Minimum="8" Maximum="72"/>
                            <TextBlock x:Name="valKeyFont" Text="20" FontSize="12" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>


                        <Expander Header="固定布局光效" Style="{DynamicResource Fold}" x:Name="expGlow">
                            <StackPanel>
                                <CheckBox Content="启用光效" Style="{DynamicResource Toggle}" x:Name="chkGlowEnable"/>
                                <CheckBox Content="跟随键身颜色" Style="{DynamicResource Toggle}" x:Name="chkGlowFollow"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="光效大小" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldGlowSize" Minimum="0" Maximum="50"/><TextBlock x:Name="valGlowSize" Text="20" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="不透明度" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldGlowOp" Minimum="0" Maximum="100"/><TextBlock x:Name="valGlowOp" Text="70%" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="光效颜色" FontSize="13" Width="80" VerticalAlignment="Center"/>
                                    <Button x:Name="btnGlowColor" Style="{DynamicResource ColorBtn}" Click="PickColor"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="固定背景渐变" Style="{DynamicResource Fold}" x:Name="expBgGrad">
                            <StackPanel>
                                <CheckBox Content="启用渐变" Style="{DynamicResource Toggle}" x:Name="chkBgGrad"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="顶部" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnBgTop" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="底部" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnBgBottom" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="按下顶部" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnBgTopC" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="按下底部" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnBgBottomC" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="固定文本渐变" Style="{DynamicResource Fold}" x:Name="expTextGrad">
                            <StackPanel>
                                <CheckBox Content="启用渐变" Style="{DynamicResource Toggle}" x:Name="chkTextGrad"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="左" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnTextLeft" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="右" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnTextRight" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="按下左" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnTextLeftC" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="按下右" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnTextRightC" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="固定描边渐变" Style="{DynamicResource Fold}" x:Name="expOutlineGrad">
                            <StackPanel>
                                <CheckBox Content="启用渐变" Style="{DynamicResource Toggle}" x:Name="chkOutlineGrad"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="上" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnOutTop" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="下" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnOutBottom" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="按下上" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnOutTopC" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="按下下" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnOutBottomC" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="文本样式（描边 / 阴影）" Style="{DynamicResource Fold}" x:Name="expTextStyle">
                            <StackPanel>
                                <CheckBox Content="描边" Style="{DynamicResource Toggle}" x:Name="chkTextOutline"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="描边颜色" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnOutlineColor" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="描边厚度" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldOutlineW" Minimum="0" Maximum="100"/><TextBlock x:Name="valOutlineW" Text="0.30" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <CheckBox Content="阴影" Style="{DynamicResource Toggle}" x:Name="chkTextShadow" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="阴影颜色" FontSize="13" Width="80" VerticalAlignment="Center"/><Button x:Name="btnShadowColor" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="阴影偏移 X" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldShadowX" Minimum="-20" Maximum="20"/><TextBlock x:Name="valShadowX" Text="2" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="阴影偏移 Y" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldShadowY" Minimum="-20" Maximum="20"/><TextBlock x:Name="valShadowY" Text="2" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="阴影柔化" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldShadowSoft" Minimum="0" Maximum="16"/><TextBlock x:Name="valShadowSoft" Text="4" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="按压动画缓动" Style="{DynamicResource Fold}" x:Name="expEasing">
                            <StackPanel>
                                <CheckBox Content="启用按压缩放" Style="{DynamicResource Toggle}" x:Name="chkPressAnim"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="动画缩放" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldPressScale" Minimum="0.5" Maximum="1" SmallChange="0.01"/><TextBlock x:Name="valPressScale" Text="0.95" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="动画时长(ms)" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldPressDur" Minimum="10" Maximum="2000"/><TextBlock x:Name="valPressDur" Text="80" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <CheckBox Content="雨滴动画（键雨跟随缩放）" Style="{DynamicResource Toggle}" x:Name="chkPressRain"/>
                                <ComboBox Style="{DynamicResource SelBox}" x:Name="cmbEasing"/>
                                <Border Style="{DynamicResource Hint}">
                                    <TextBlock Text="缓动覆盖 27 种命名曲线（对齐原 Mod KvEasing），按下/释放共用" FontSize="11" Foreground="{DynamicResource Dim}"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== 按键页 ================================================== -->
            <TabItem Header="按键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 设置页面快捷键（全局热键，位于「改键」之上） -->
                        <TextBlock Style="{DynamicResource Sec}" Text="设置页面快捷键"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnSettingsHotkey" Style="{DynamicResource Kbtn}" MinWidth="96"
                                    Click="SettingsHotkeyClick"/>
                            <TextBlock x:Name="txtSettingsHotkeyHint" FontSize="11"
                                       Foreground="{DynamicResource Alias}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" Text="点击后按下要设置的键（Esc 取消）"/>
                        </StackPanel>

                        <Expander Header="改键" Style="{DynamicResource Fold}" x:Name="expBind" IsExpanded="True">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 1 排按键:"/>
                                <StackPanel x:Name="bindRow1" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 2 排按键:"/>
                                <StackPanel x:Name="bindRow2" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 3 排按键:"/>
                                <StackPanel x:Name="bindRow3" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtBindHint" Text="点击按键开始改键，随后按下要绑定的键（Esc 取消）"
                                           FontSize="11" Foreground="{DynamicResource Dim}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{DynamicResource Fold}" x:Name="expGhostBind">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="补拍键"/>
                                    <TextBlock Text="/鬼键" Foreground="{DynamicResource Alias}"/>
                                    <TextBlock Text=" (GhostKey)"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 1 排按键:"/>
                                <StackPanel x:Name="ghostRow1" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 2 排按键:"/>
                                <StackPanel x:Name="ghostRow2" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 3 排按键:"/>
                                <StackPanel x:Name="ghostRow3" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtGhostHint" Text="点击按键开始绑定补拍键（Esc 取消）；补拍键本身不计入统计"
                                           FontSize="11" Foreground="{DynamicResource Dim}"/>
                            </StackPanel>
                        </Expander>

                        

                        <Expander Header="文本修改" Style="{DynamicResource Fold}" x:Name="expTextEdit">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 1 排按键:"/>
                                <StackPanel x:Name="textRow1" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 2 排按键:"/>
                                <StackPanel x:Name="textRow2" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <TextBlock Style="{DynamicResource Sec}" Text="第 3 排按键:"/>
                                <StackPanel x:Name="textRow3" Orientation="Horizontal" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="输入文本:" FontSize="13" Foreground="{DynamicResource Dim}" Width="70" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtKeyText" Style="{DynamicResource Txt}" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="保存" Style="{DynamicResource Btn}" Click="SaveKeyTextClick"/>
                                    <Button Content="重置" Style="{DynamicResource BtnRed}" Margin="8,0,0,0" Click="ResetKeyTextClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="KPS / Total 自定义文本" Style="{DynamicResource Fold}" x:Name="expKpsText">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="KPS 文本:" FontSize="13" Foreground="{DynamicResource Dim}" Width="70" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtKpsLabel" Style="{DynamicResource Txt}" Text="KPS" VerticalContentAlignment="Center"/>
                                    <Button Content="重置" Style="{DynamicResource Btn}" Margin="8,0,0,0" Click="ResetKpsLabel"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Total 文本:" FontSize="13" Foreground="{DynamicResource Dim}" Width="70" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtTotalLabel" Style="{DynamicResource Txt}" Text="Total" VerticalContentAlignment="Center"/>
                                    <Button Content="重置" Style="{DynamicResource Btn}" Margin="8,0,0,0" Click="ResetTotalLabel"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== 键雨页 ================================================== -->
            <TabItem Header="键雨">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox Content="启用键雨效果" Style="{DynamicResource Toggle}" x:Name="chkRainEnable"/>
                        <Border Style="{DynamicResource Hint}">
                            <TextBlock Text="启用后窗口自动向上增加键雨区高度，KV 与键雨整体等比缩放居中。" FontSize="11" Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Style="{DynamicResource Sec}" Text="键雨排:"/>
                        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,6">
                            <CheckBox Content="第 1 排" Style="{DynamicResource Toggle}" x:Name="chkRainR1"/>
                            <CheckBox Content="第 2 排" Style="{DynamicResource Toggle}" x:Name="chkRainR2"/>
                            <CheckBox Content="第 3 排" Style="{DynamicResource Toggle}" x:Name="chkRainR3"/>
                        </UniformGrid>

                        <!-- 常显项集中放在"键雨排"下面，使可折叠的逐排参数项（速度/高度/宽度/起始位置/阴影/描边/补拍键雨）连续排列 -->
                        <CheckBox Content="松开时淡出" Style="{DynamicResource Toggle}" x:Name="chkRainFade"/>
                        <CheckBox Content="顶部渐隐" Style="{DynamicResource Toggle}" x:Name="chkRainGrad"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="淡出时长" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldRainFadeT" Minimum="30" Maximum="200"/><TextBlock x:Name="valRainFadeT" Text="0.50" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="顶部渐隐" FontSize="13" Width="80" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldRainFadePx" Minimum="0" Maximum="200"/><TextBlock x:Name="valRainFadePx" Text="40" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>

                        <TextBlock Style="{DynamicResource Sec}" Text="键雨颜色:"/>
                        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="第 1 排" FontSize="13" Width="70" VerticalAlignment="Center"/><Button x:Name="btnRain1" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="第 2 排" FontSize="13" Width="70" VerticalAlignment="Center"/><Button x:Name="btnRain2" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="第 3 排" FontSize="13" Width="70" VerticalAlignment="Center"/><Button x:Name="btnRain3" Style="{DynamicResource ColorBtn}" Click="PickColor"/></StackPanel>
                        </UniformGrid>

                        <Expander Header="速度" Style="{DynamicResource Fold}" x:Name="expRainSp">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="第 1 排" FontSize="13" Width="70" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldRainSp1" Minimum="1" Maximum="300"/><TextBlock x:Name="valRainSp1" FontSize="12" Width="50" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="第 2 排" FontSize="13" Width="70" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldRainSp2" Minimum="1" Maximum="300"/><TextBlock x:Name="valRainSp2" FontSize="12" Width="50" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="第 3 排" FontSize="13" Width="70" VerticalAlignment="Center"/><Slider Style="{DynamicResource Slider}" x:Name="sldRainSp3" Minimum="1" Maximum="300"/><TextBlock x:Name="valRainSp3" FontSize="12" Width="50" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="高度" Style="{DynamicResource Fold}" x:Name="expRainH">
